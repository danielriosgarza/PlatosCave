    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
