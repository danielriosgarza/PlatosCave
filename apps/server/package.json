{
  "name": "@parallax/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts relay",
    "start": "tsx src/main.ts relay",
    "worker": "tsx src/main.ts worker",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "connectors:register-managed": "tsx src/scripts/register-managed-connector.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/lib-storage": "3.1144.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.6",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.0",
    "@fastify/websocket": "11.3.1",
    "@parallax/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "hast-util-to-string": "3.0.1",
    "nodemailer": "10.0.13",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
