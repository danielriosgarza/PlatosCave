// Feature modules receive the database handle through `deps.db` and pass it to data-access
// functions; they never build queries on it themselves (ADR-0002, Scoped tables).
//
// The handle is recognised by the name `db`. A renamed alias (`const conn = deps.db`) is not
// caught, and any other object stored under `db` (`deps.cache.db.delete(key)`) is flagged.
//
// Exempt files are listed in biome.json. ADR-0002 says "outside db/"; the existing data-access
// files under auth/, content/ and storage/ take branded scopes and are exempt by name until they
// move under db/, so any other file, existing or new, stays restricted unless biome.json names it.
language js

// Member access covers optional chaining (`deps.db?.select()`).
or {
  member_expression(object=$receiver, property=$method) where {
    $receiver <: or {
      `db`,
      member_expression(property=`db`)
    },
    $method <: r"^(?:select|selectDistinct|selectDistinctOn|insert|update|delete|execute|query|transaction|\$client|\$count|\$with|with|refreshMaterializedView)$",
    register_diagnostic(span=$method, message="Raw database query outside a data-access module. Call a db/ function that takes a branded ClassScope/CourseScope instead (ADR-0002, Scoped tables).")
  },
  member_expression(property=$method) where {
    $method <: `createDb`,
    register_diagnostic(span=$method, message="Only the composition root (main.ts) opens the database client (ADR-0002, Scoped tables).")
  }
}
