// Feature modules receive the database handle through `deps.db` and pass it to data-access
// functions; they never build queries on it themselves (ADR-0002, Scoped tables).
//
// The handle is recognised by the name `db`: `db`, `<x>.db`, `<x>['db']`, the `db()` accessor
// the route modules define, and any of these wrapped in parentheses, `!`, `as`, `<T>` or
// `satisfies`. Destructuring a query method (or a rest element) from the handle is flagged,
// directly in a declaration (`const { select } = deps.db`, `const { ...all } = deps.db`) or
// through a `db` key in any binding, parameters included (`const { db: { select } } = deps`,
// `function f({ db: { select } }: Deps)`).
// Known limits, not caught: a renamed alias (`const conn = deps.db`); assignment and
// `for ... of` destructuring of the handle, and parameter destructuring other than through a
// `db` key; a computed member with a non-literal key (`deps.db[name]()`); the handle reached
// through an array (`[deps.db][0].select()`); passing the handle to an untyped helper; a
// dynamic import of db/client whose specifier is not a literal (`await import(path)`,
// `import('../db/' + 'client')`); parameter destructuring of `createDb`, including inside a
// default value (`{ open = ({ createDb: c }) => c() }`), which is an expression, not a binding
// of the declaration; and a non-literal computed `createDb` key (`const { [name]: f } = client`),
// which has no receiver to anchor a conservative rule to.
// Any other object stored under `db` is treated as the handle when a query method name is used
// on it, or a rest element or a computed key that is not a plain string or number literal
// destructures it (`deps.cache.db.delete(key)`, `const { ...all } = deps.config.db`,
// `const { [key]: value } = deps.config.db` and `const { [('url')]: u } = deps.config.db` are
// flagged).
//
// The rules compare source text, so a key, subscript or module specifier spelled with an escape
// (`'sel\x65ct'`, `deps.db['sel\x65ct']`, `'../db/cl\x69ent'`) could name anything; feature code
// must spell them plainly, and any escaped one is flagged.
//
// The plugin runs from the biome.json override that exempts the data-access modules under db/,
// the composition root main.ts and test files (ADR-0002, Scoped tables); every other server
// file, existing or new, is restricted.
//
// Node names are Biome's own (`JsParenthesizedExpression`, `TsAsExpression`, ...); tree-sitter
// names such as `as_expression` do not compile in this Biome version.
language js

pattern db_handle() {
  or {
    `db`,
    member_expression(property=`db`),
    subscript_expression(index=r"^['\"`]db['\"`]$"),
    call_expression(function=`db`),
    call_expression(function=member_expression(property=`db`)),
    JsParenthesizedExpression(expression=db_handle()),
    TsNonNullAssertionExpression(expression=db_handle()),
    TsAsExpression(expression=db_handle()),
    TsTypeAssertionExpression(expression=db_handle()),
    TsSatisfiesExpression(expression=db_handle())
  }
}

// A destructuring key named `$name`: plain, quoted, or a computed string literal
// (`{ select }`, `{ 'select': s }`, `{ ['select']: s }`, but not `{ [select]: s }`). `$key` is
// bound to the key, for the diagnostic span.
pattern binding_key($name, $key) {
  or {
    JsObjectBindingPatternShorthandProperty(identifier=$key),
    JsObjectBindingPatternProperty(member=$key)
  } where {
    $key <: or {
      JsLiteralMemberName() as $member where { $member <: $name },
      JsComputedMemberName(expression=$literal) where {
        $literal <: literal_text(),
        $literal <: $name
      },
      JsIdentifierBinding() as $binding where { $binding <: $name }
    }
  }
}

// A string, or a template without substitutions or tag: a literal whose text is its value
// (unless it is escaped).
pattern literal_text() {
  or {
    JsStringLiteralExpression(),
    JsTemplateExpression() as $template where {
      $template <: not contains JsTemplateElement(),
      $template <: r"(?s)^`.*"
    }
  }
}

// A literal whose text is exactly the key or path it names: no escapes.
pattern string_literal() { literal_text() as $literal where { $literal <: not escaped() } }

pattern escaped() { r"(?s).*\\.*" }

// A destructuring key that names a query method; a computed key that is not a string or number
// literal (`{ [name]: s }`, which may name any of them); or a rest element that captures them
// all. Escaped keys are reported by the escape rule.
pattern db_binding_key() {
  or {
    JsObjectBindingPatternRest(),
    JsObjectBindingPatternProperty(member=JsComputedMemberName(expression=$e)) where {
      $e <: not or {
        literal_text(),
        JsNumberLiteralExpression(),
        JsUnaryExpression(argument=JsNumberLiteralExpression())
      }
    },
    binding_key(name=db_method(), key=$_)
  }
}

// GritQL does not take a regex literal as a pattern argument, so names are patterns.
pattern db_name() { r"^['\"`]?db['\"`]?$" }

pattern create_db_name() { r"^['\"`]?createDb['\"`]?$" }

pattern db_client_path() { r"^['\"`](?:.*/)?db/client(?:\.js|\.ts)?['\"`]$" }

pattern db_method() {
  r"^['\"`]?(?:select|selectDistinct|selectDistinctOn|insert|update|delete|execute|query|transaction|_|\$client|\$count|\$with|with|refreshMaterializedView)['\"`]?$"
}

// Member access covers optional chaining (`deps.db?.select()`); subscript access covers
// `deps.db['select']`; `_` is drizzle's internals object (`deps.db._.session`).
//
// `noRestrictedImports` matches the `db/client` group by import name, so it does not see a
// namespace import of that module (`import * as client`, `import x, * as client`,
// `await import('…')` with a literal specifier) or a star re-export of it (`export * from`,
// `export * as ns from`); those are flagged here unless type-only (`typeof import(...)` is a
// type). Feature code imports what it needs from db/client by name (`type Db`, `probe`).
// `createDb` is also flagged as a member (`client.createDb`, `client['createDb']`) and as a key
// destructured in a variable declaration (`const { createDb } = client`), in case a module
// object reaches feature code another way. The other restricted modules are matched by path,
// and `noRestrictedImports` reports their star re-exports itself.
or {
  or {
    member_expression(object=$receiver, property=$method),
    subscript_expression(object=$receiver, index=$method)
  } where {
    $receiver <: db_handle(),
    $method <: db_method(),
    register_diagnostic(span=$method, message="Raw database query outside a data-access module. Call a db/ function that takes a branded ClassScope/CourseScope instead (ADR-0002, Scoped tables).")
  },
  JsVariableDeclarator(id=$pattern, initializer=JsInitializerClause(expression=$value)) where {
    $pattern <: JsObjectBindingPattern(properties=$keys),
    $value <: db_handle(),
    $keys <: some db_binding_key(),
    register_diagnostic(span=$pattern, message="Destructuring the database handle outside a data-access module. Call a db/ function that takes a branded ClassScope/CourseScope instead (ADR-0002, Scoped tables).")
  },
  // `until` stops at the first nested pattern, so only keys directly under `db` count, and at a
  // default value, which is an expression (`{ db: h = ({ select }) => select }` is clean).
  binding_key(name=db_name(), key=$name) as $property where {
    $property <: contains JsObjectBindingPattern(properties=$keys) until or {
      JsObjectBindingPattern(),
      JsInitializerClause()
    },
    $keys <: some db_binding_key(),
    register_diagnostic(span=$name, message="Destructuring the database handle outside a data-access module. Call a db/ function that takes a branded ClassScope/CourseScope instead (ADR-0002, Scoped tables).")
  },
  or {
    JsVariableDeclarator(id=$pattern, initializer=JsInitializerClause()),
    JsForVariableDeclaration(declarator=JsVariableDeclarator(id=$pattern))
  } where {
    // Default values are expressions, not bindings: `{ fn = ({ createDb }) => 0 }` is clean.
    $pattern <: contains binding_key(name=create_db_name(), key=$key) until JsInitializerClause(),
    register_diagnostic(span=$key, message="Only the composition root (main.ts) opens the database client (ADR-0002, Scoped tables).")
  },
  or {
    member_expression(property=$method),
    subscript_expression(index=$method)
  } where {
    $method <: create_db_name(),
    register_diagnostic(span=$method, message="Only the composition root (main.ts) opens the database client (ADR-0002, Scoped tables).")
  },
  // The path test sits in each arm: for a dynamic import, `contains` must search for a literal
  // that matches the path, not bind the first literal and test that.
  or {
    or {
      JsExportFromClause(source=$source),
      JsImportNamespaceClause(source=$source)
    } as $clause where { $clause <: not r"(?s)^type\b.*", $source <: db_client_path() },
    // A combined clause cannot be type-only (TS1363); `type` here may be the default binding.
    JsImportCombinedClause(specifier=JsNamespaceImportSpecifier(), source=$source) where {
      $source <: db_client_path()
    },
    JsImportCallExpression(arguments=$args) where {
      $args <: contains string_literal() as $source where { $source <: db_client_path() }
    }
  } where {
    register_diagnostic(span=$source, message="Only the composition root (main.ts) opens the database client; import or re-export what a feature module needs by name (ADR-0002, Scoped tables).")
  },
  // Escapes: destructuring keys, subscripts, and module specifiers of imports, re-exports and
  // dynamic imports.
  or {
    JsObjectBindingPatternShorthandProperty(identifier=$escaped),
    JsObjectBindingPatternProperty(member=JsLiteralMemberName() as $escaped),
    JsObjectBindingPatternProperty(member=JsComputedMemberName(expression=$escaped)) where {
      $escaped <: literal_text()
    },
    subscript_expression(index=$escaped) where { $escaped <: literal_text() },
    JsModuleSource() as $escaped,
    JsImportCallExpression(arguments=$args) where {
      $args <: contains literal_text() as $escaped where { $escaped <: escaped() }
    }
  } where {
    $escaped <: escaped(),
    register_diagnostic(span=$escaped, message="Escaped key or module specifier outside a data-access module. Spell it plainly so the raw database access rules can check it (ADR-0002, Scoped tables).")
  }
}
