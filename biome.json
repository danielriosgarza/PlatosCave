{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/routeTree.gen.ts",
      "!**/drizzle/meta",
      "!.local",
      "!.claude",
      "!docs/wireframe.html"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": [
        "apps/server/src/**",
        "!apps/server/src/db/**",
        "!apps/server/src/main.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./apps/server/lint/raw-db-query.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**", "pg", "pg/**"],
                    "message": "Query builders and the database driver are for data-access modules only. Feature modules reach the database only through data-access functions in db/ that take a branded ClassScope/CourseScope (ADR-0002, Scoped tables)."
                  },
                  {
                    "group": [
                      "**/db/schema",
                      "**/db/schema.js",
                      "**/db/schema.ts",
                      "**/db/schema/index",
                      "**/db/schema/index.js",
                      "**/db/schema/index.ts",
                      "**/db/scoped",
                      "**/db/scoped.js",
                      "**/db/scoped.ts",
                      "**/db/admin",
                      "**/db/admin.js",
                      "**/db/admin.ts",
                      "**/db/migrate",
                      "**/db/migrate.js",
                      "**/db/migrate.ts",
                      "**/db/reset",
                      "**/db/reset.js",
                      "**/db/reset.ts",
                      "**/db/schema/**"
                    ],
                    "message": "Tables (including type-only imports) and database administration are for data-access modules only; export row types a feature module needs from a db/ module. Feature modules reach the database only through data-access functions in db/ that take a branded ClassScope/CourseScope (ADR-0002, Scoped tables)."
                  },
                  {
                    "group": ["**/db/client", "**/db/client.js", "**/db/client.ts"],
                    "importNamePattern": "createDb",
                    "message": "Only the composition root (main.ts) opens the database client. Feature modules reach the database only through data-access functions in db/ that take a branded ClassScope/CourseScope (ADR-0002, Scoped tables)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
