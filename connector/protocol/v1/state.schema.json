{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallax.invalid/connector/v1/state.schema.json",
  "title": "Parallax connector state files (protocol v1)",
  "description": "The JSON files in the connector state directory (docs/design/connector.md sections 3 and 9). identity.key and known_hosts are not JSON.",
  "anyOf": [
    {
      "$ref": "#/$defs/Config"
    },
    {
      "$ref": "#/$defs/Sessions"
    },
    {
      "$ref": "#/$defs/Runtime"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lower-case UUID."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339, UTC, with the Z suffix."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "description": "A path on the machine the message names. Absolute, free of dot-dot segments and POSIX or drive-rooted: semantic rules."
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9.:-]+$",
      "description": "Host name or IP literal. Syntax and range rules beyond this pattern are the semantic rules of docs/design/connector.md section 4.4."
    },
    "user": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.@-]{0,63}$",
      "description": "Account name; never starts with a dash. No backslash: `DOMAIN\\user` names belong to Windows OpenSSH targets, which v1 does not support (docs/design/connector.md section 17)."
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "cidr": {
      "type": "string",
      "maxLength": 49,
      "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
    },
    "lease": {
      "type": "object",
      "required": ["idleTimeoutMin", "gracePeriodMin"],
      "additionalProperties": false,
      "properties": {
        "idleTimeoutMin": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        },
        "gracePeriodMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "description": "Shown before Connect and enforced by the connector (design section 9)."
    },
    "cause": {
      "enum": [
        "sleep",
        "vpn",
        "network_change",
        "ssh_timeout",
        "service_stopped",
        "allocation_expired",
        "host_unreachable",
        "process_exited",
        "lease_idle",
        "lease_grace",
        "user_stop",
        "connector_exit",
        "connector_restarted",
        "max_lifetime"
      ]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "required": ["method", "keyPath"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "key"
            },
            "keyPath": {
              "$ref": "#/$defs/path"
            }
          },
          "description": "A private key file on the connector's machine. A passphrase is asked for in the connector, never sent."
        },
        {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "agent"
            },
            "hint": {
              "type": "string",
              "maxLength": 128
            }
          },
          "description": "An identity held by the connector machine's SSH agent; `hint` selects by comment or fingerprint."
        },
        {
          "type": "object",
          "required": ["method", "keyId"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "managed_key"
            },
            "keyId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          },
          "description": "A key in the managed connector's own secret store (managed mode only)."
        }
      ]
    },
    "hop": {
      "type": "object",
      "required": ["host", "port", "user"],
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/host"
        },
        "port": {
          "$ref": "#/$defs/port"
        },
        "user": {
          "$ref": "#/$defs/user"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      },
      "description": "A jump host. Its auth defaults to the target's."
    },
    "hostKey": {
      "type": "object",
      "required": ["host", "port", "sha256"],
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/host"
        },
        "port": {
          "$ref": "#/$defs/port"
        },
        "sha256": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "description": "A host key the server remembers as trusted for this connection."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "description": "OpenSSH style: SHA256: and the unpadded base64 of a SHA-256 digest."
    },
    "Config": {
      "type": "object",
      "required": ["v", "server", "connectorId", "name", "pairedAt", "mode"],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "server": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^https?://[a-z0-9.:\\[\\]-]+$"
        },
        "connectorId": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "pairedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "mode": {
          "enum": ["personal", "managed"]
        }
      },
      "description": "config.json in the state directory."
    },
    "SessionRecord": {
      "type": "object",
      "required": [
        "sessionId",
        "owned",
        "state",
        "target",
        "lease",
        "phase",
        "lastActivityAt",
        "expiresAt",
        "hardDeadline"
      ],
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/uuid"
        },
        "owned": {
          "type": "boolean"
        },
        "state": {
          "enum": ["starting", "ready", "disconnected", "stopping", "stopped"]
        },
        "cause": {
          "$ref": "#/$defs/cause"
        },
        "stoppedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "targetId", "subject"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "managed"
                },
                "targetId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                },
                "subject": {
                  "$ref": "#/$defs/uuid"
                }
              }
            },
            {
              "type": "object",
              "required": ["kind", "workspace"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["local", "ssh"]
                },
                "host": {
                  "$ref": "#/$defs/host"
                },
                "port": {
                  "$ref": "#/$defs/port"
                },
                "user": {
                  "$ref": "#/$defs/user"
                },
                "workspace": {
                  "$ref": "#/$defs/path"
                },
                "auth": {
                  "$ref": "#/$defs/auth"
                },
                "jump": {
                  "$ref": "#/$defs/hop"
                },
                "expectedEnd": {
                  "$ref": "#/$defs/timestamp"
                },
                "hostKeys": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "$ref": "#/$defs/hostKey"
                  }
                }
              }
            }
          ]
        },
        "kernelIds": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "description": "Kernels this session created; the only kernel ids the allowlist accepts."
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "process": {
          "type": "object",
          "required": ["where", "pid", "port", "startedAt"],
          "additionalProperties": false,
          "properties": {
            "where": {
              "enum": ["local", "remote"]
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "port": {
              "$ref": "#/$defs/port"
            },
            "startedAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "phase": {
          "enum": ["attached", "detached"]
        },
        "lastActivityAt": {
          "$ref": "#/$defs/timestamp"
        },
        "detachedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "hardDeadline": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "description": "One session the connector holds, or has stopped and not yet reported (`state: stopped` with `cause` and `stoppedAt`, kept until a `session_state stopped` was sent on a live link). Never a token, key, passphrase or password. `process` is absent for an attached session the connector did not start."
    },
    "Sessions": {
      "type": "object",
      "required": ["v", "sessions"],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "sessions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/SessionRecord"
          }
        }
      },
      "description": "sessions.json: written atomically (temporary file, then rename) with mode 0600."
    },
    "Runtime": {
      "type": "object",
      "required": ["v", "pid", "startedAt", "link", "since", "sessions"],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "link": {
          "enum": ["connecting", "authenticating", "up", "down", "pending", "revoked", "rejected"]
        },
        "since": {
          "$ref": "#/$defs/timestamp"
        },
        "lastError": {
          "type": "string",
          "maxLength": 200
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      },
      "description": "runtime.json: what `status` prints while `run` is alive."
    }
  }
}
