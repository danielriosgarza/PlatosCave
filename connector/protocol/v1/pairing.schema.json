{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallax.invalid/connector/v1/pairing.schema.json",
  "title": "Parallax connector pairing endpoints (protocol v1)",
  "description": "Bodies of the unauthenticated-by-session endpoints under /api/connector/v1 (docs/design/connector.md section 3).",
  "anyOf": [
    {
      "$ref": "#/$defs/PairRequest"
    },
    {
      "$ref": "#/$defs/PairResponse"
    },
    {
      "$ref": "#/$defs/SignedRequest"
    },
    {
      "$ref": "#/$defs/PollResponse"
    },
    {
      "$ref": "#/$defs/ErrorBody"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lower-case UUID."
    },
    "b64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 bytes, base64url without padding."
    },
    "b64url64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "description": "64 bytes, base64url without padding."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "description": "OpenSSH style: SHA256: and the unpadded base64 of a SHA-256 digest."
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "unixSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339, UTC, with the Z suffix."
    },
    "os": {
      "enum": ["linux", "darwin", "windows"]
    },
    "arch": {
      "enum": ["amd64", "arm64"]
    },
    "PairRequest": {
      "type": "object",
      "required": ["code", "publicKey", "name", "os", "arch", "version"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$",
          "description": "The pairing code without its hyphen, upper case, Crockford base 32 with O read as 0 and I and L as 1 before sending."
        },
        "publicKey": {
          "$ref": "#/$defs/b64url32"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "os": {
          "$ref": "#/$defs/os"
        },
        "arch": {
          "$ref": "#/$defs/arch"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "description": "Body of POST /api/connector/v1/pair."
    },
    "PairResponse": {
      "type": "object",
      "required": ["connectorId", "fingerprint", "status", "pollAfterSeconds", "approveBy"],
      "additionalProperties": false,
      "properties": {
        "connectorId": {
          "$ref": "#/$defs/uuid"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "status": {
          "const": "pending"
        },
        "pollAfterSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "approveBy": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "description": "Answer 201. The fingerprint is shown by the connector and by the approval screen so the person can compare them."
    },
    "SignedRequest": {
      "type": "object",
      "required": ["connectorId", "ts", "sig"],
      "additionalProperties": false,
      "properties": {
        "connectorId": {
          "$ref": "#/$defs/uuid"
        },
        "ts": {
          "$ref": "#/$defs/unixSeconds"
        },
        "sig": {
          "$ref": "#/$defs/b64url64"
        }
      },
      "description": "Body of POST /api/connector/v1/pair/poll (label parallax-connector-poll-v1) and POST /api/connector/v1/unpair (label parallax-connector-unpair-v1)."
    },
    "PollResponse": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "active", "rejected", "expired"]
        },
        "pollAfterSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "ErrorBody": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "maxLength": 200
        }
      },
      "description": "Every refusal: 400, 401, 404, 410, 429."
    }
  }
}
