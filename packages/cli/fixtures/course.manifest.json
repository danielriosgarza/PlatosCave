                  "prompt": "A transect crosses 4 quadrats of 1 m² each. How many square metres are sampled?",
                  "hints": ["Each quadrat covers one square metre (sentinel-hint)."],
                  "solution": "Four quadrats of one square metre each give 4 m² (sentinel-solution).",
                  "kind": "numeric",
                  "answer": 4,
                  "tolerance": 0,
                  "unit": "m²",
                  "feedback": {
                    "correct": "Yes, 4 m² (sentinel-feedback).",
                    "incorrect": "Count the quadrats again."
                  }
                },
                {
                  "id": "choose",
                  "title": "Choose",
                  "prompt": "Which count is a density?",
                  "hints": [],
                  "kind": "single_choice",
                  "options": [
                    {
                      "id": "a",
                      "label": "12 fish"
                    },
                    {
                      "id": "sentinel-answer",
                      "label": "3 fish per square metre"
                    }
                  ],
                  "shuffle": false,
                  "feedback": {
                    "correct": "Yes.",
                    "incorrect": "A density divides a count by an area."
                  },
                  "correct": "sentinel-answer"
                }
              ]
            }
