{
  "name": "parallax-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "parallax": "./bin/parallax.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pages": {
      "types": "./pages.d.ts"
    }
  },
  "files": [
    "bin",
    "pages.d.ts",
    "src",
    "!src/**/*.test.ts",
    "vendor",
    "tsconfig.base.json"
  ],
  "parallax": {
    "registry": "ghcr.io/danielriosgarza"
  },
  "scripts": {
    "prepack": "tsx scripts/vendor.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/router-plugin": "1.168.41",
    "@vitejs/plugin-react": "6.1.1",
    "dompurify": "3.4.16",
    "hast-util-from-parse5": "8.0.3",
    "hast-util-to-string": "3.0.1",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "8.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@parallax/contracts": "workspace:*"
  }
}
