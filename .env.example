# The API (`pnpm --filter @parallax/server start`) and the job worker (`... worker`) read this
# same environment, production secrets included: deploy both roles with one configuration.
DATABASE_URL=postgres://parallax:parallax@127.0.0.1:54329/parallax
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
STATIC_DIR=
# Two host names, one server (ADR-0002). Requests whose Host is CONTENT_HOST only reach
# /content/<token>; everything else (API, web app) answers on other hosts. HOST is only the
# listen address: with these defaults 127.0.0.1 is the content origin, so open the app at
# http://localhost:5173 (Vite keeps that Host when proxying /api) and call the API at
# http://localhost:3000/api/...; http://127.0.0.1:3000/api/... answers 404. E2E swaps the two.
APP_HOST=localhost
CONTENT_HOST=127.0.0.1
CONTENT_ORIGIN=
CONTENT_TOKEN_SECRET=
STORAGE_DRIVER=fs
STORAGE_DIR=.local/storage
# STORAGE_DRIVER=s3: `pnpm compose --profile s3 up -d garage && bash scripts/garage-init.sh`
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required in production; development uses a built-in secret and http://localhost:5173.
SESSION_SECRET=
APP_ORIGIN=
# file (JSON files under MAIL_DIR) or smtp (needs SMTP_URL and MAIL_FROM)
MAIL_TRANSPORT=file
MAIL_DIR=.local/mail
SMTP_URL=
# Sender of sign-in mail, e.g. "Parallax <login@example.org>". Required for smtp (use an address
# the relay accepts); the file transport defaults to a placeholder.
MAIL_FROM=
# Comma-separated emails of people who may create courses before they teach anything (matched
# trimmed and case-insensitively). People who already teach can always create courses; empty
# means only they can. Read at start-up.
INSTRUCTOR_EMAILS=
# Per client IP, per 15 minutes. Each address is also capped (five unused links per 15 minutes,
# then one a minute), so these only slow address guessing; a class signing in together from one campus NAT must fit.
AUTH_LINK_RATE_LIMIT=120
AUTH_VERIFY_RATE_LIMIT=240
# Behind a reverse proxy, name it so rate limits key on the client and not on the proxy.
# Required in production (use false only when no proxy sits in front).
# Prefer a comma-separated list of your proxies' addresses or CIDR ranges, e.g. 10.0.0.0/8: the
# client address is then the first one that is not yours, which a client cannot choose. `true`
# believes every X-Forwarded-For entry, so the client's own header decides its address (and
# voids the per-IP limits) unless the proxy REPLACES that header; nginx's default
# $proxy_add_x_forwarded_for appends. A bare hop count is refused (Fastify 5 would trust nobody).
# This also makes X-Forwarded-Host choose `request.host` in logs; the app/content origin split
# reads the raw Host header, so the proxy must forward Host unchanged (APP_HOST / CONTENT_HOST).
TRUST_PROXY=false
