DATABASE_URL=postgres://parallax:parallax@127.0.0.1:54329/parallax
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
STATIC_DIR=
# Two host names, one server (ADR-0002). Requests whose Host is CONTENT_HOST only reach
# /content/<token>; everything else (API, web app) answers on other hosts. With these defaults
# open the app at http://localhost:5173 (Vite) or call http://localhost:3000/api/...;
# http://127.0.0.1:3000/api/... is the content origin and answers 404. E2E swaps the two.
APP_HOST=localhost
CONTENT_HOST=127.0.0.1
CONTENT_ORIGIN=
CONTENT_TOKEN_SECRET=
STORAGE_DRIVER=fs
STORAGE_DIR=.local/storage
# STORAGE_DRIVER=s3: `pnpm compose --profile s3 up -d garage && bash scripts/garage-init.sh`
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
